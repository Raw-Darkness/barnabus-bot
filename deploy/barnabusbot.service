[Unit]
Description=Barnabus moderation bot
After=network-online.target
Wants=network-online.target

[Service]
User=barnabus
WorkingDirectory=/opt/barnabus/app
ExecStart=/opt/barnabus/venv/bin/python -m barnabus
Restart=always
RestartSec=5
# 78 = rejected/missing token or unapproved intent: a human has to fix it.
RestartPreventExitStatus=78
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/barnabus

[Install]
WantedBy=multi-user.target
